# Local Agent env — copy to `.env` (gitignored) or export in shell.
# Never commit real OBS passwords or production tokens.

# Platform HTTP base (Agent derives ws://…/ws/agent/{match})
STK_PLATFORM_URL=http://127.0.0.1:8000

# Match id from POST /api/v1/matches
STK_MATCH_ID=m_dev

# Must match Platform STK_AGENT_TOKEN (root .env / compose)
STK_AGENT_TOKEN=dev_agent_token_change_me

# OBS WebSocket v5 (omit / use --fake-obs when no OBS)
STK_OBS_URL=ws://127.0.0.1:4455
# STK_OBS_PASSWORD=change_me_obs_ws
