# StudentTournamentKit — git ignore

# --- Secrets (never commit) ---
config/secrets/
.env
.env.*
!.env.example
apps/**/.env
apps/**/.env.*
!apps/**/.env.example
*.pem
*.key
id_rsa*
credentials.json

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- IDE / editors ---
.idea/
.vscode/
*.swp
*.swo
*~
*.user
*.suo
*.userosscache
*.sln.docstates

# Cursor — local state only; .cursor/rules and .cursor/skills stay trackable
.cursor/projects/
.cursor/**/*.log

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
.venv/
venv/
.env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/
pip-wheel-metadata/
apps/api/.venv/

# --- Node / frontend ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/
.svelte-kit/
.vite/
*.local

# --- .NET / C# (STK.Bridge, CounterStrikeSharp build output) ---
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
project.lock.json
project.fragment.lock.json
artifacts/
*.nupkg

# --- Go (director-agent; see also apps/director-agent/.gitignore) ---
*.test
*.out
coverage.out

# --- Build / dist (generic) ---
dist/
build/
out/
*.tsbuildinfo

# --- App / runtime data ---
data/demos/
!data/demos/README.md
data/demos/_ephemeral/
*.log
logs/

# --- Fake CS2 / local tools ---
tools/fake-cs2/.venv/
tools/fake-cs2/*.jsonl

# --- CS2 local install (if symlinked/copied into repo) ---
/cs2_dedicated_server/
gameinfo.gi.bak*
gameinfo.gi.STK-FIXED
gameinfo.gi.stk-pending
gameinfo.gi.*.bak-stk*

# --- Plugin install cache (install-local-cs2-plugins.ps1) ---
stk-cs2-plugins-install/

# --- Docker / local volumes ---
*.sql.gz

# --- TLS / local certs ---
/certs/
