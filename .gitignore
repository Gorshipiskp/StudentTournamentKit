# StudentTournamentKit — git ignore

# --- Secrets (never commit) ---
config/secrets/
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
credentials.json

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- IDE / editors ---
.idea/
.vscode/
.cursor/
*.swp
*.swo
*~

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
.venv/
venv/
.env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/
pip-wheel-metadata/

# --- Node / frontend (when added) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# --- Build / dist ---
dist/
build/
out/
*.tsbuildinfo

# --- App / runtime data ---
data/demos/
!data/demos/README.md
data/demos/_ephemeral/
*.log
logs/

# --- Fake CS2 / local tools ---
tools/fake-cs2/.venv/
tools/fake-cs2/*.jsonl

# --- Docker / local volumes (if created under repo) ---
*.sql.gz

# --- Cursor (local agent state; keep project rules) ---
# .cursor/rules and .cursor/skills are tracked; ignore caches if any
.cursor/*.log
/cs2_dedicated_server/
/certs/
