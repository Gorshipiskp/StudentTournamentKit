# StudentTournamentKit — local / platform env schema
# Copy to `.env` and adjust. Never commit real secrets.

# --- MySQL ---
# Owner setup (2026-08-11): remote managed MySQL (Timeweb / *.twc1.net) is the working DB.
# Put real host/user/password/database in `.env` only — never commit secrets.
# Local compose defaults below are for offline/CI when remote is unavailable.
MYSQL_ROOT_PASSWORD=changeme_root_dev
MYSQL_DATABASE=stk
MYSQL_USER=stk
MYSQL_PASSWORD=changeme_stk_dev
# Remote example (host tools / uvicorn on laptop):
# MYSQL_HOST=xxxx.twc1.net
# MYSQL_PORT=3306
# MYSQL_DATABASE=your_db
# MYSQL_USER=your_user
# MYSQL_PASSWORD=...
# Managed MySQL (Timeweb): require_secure_transport=ON — включи TLS:
MYSQL_SSL=1
MYSQL_SSL_CA=C:/path/to/ca.pem
# Inside compose network use host `mysql`. From host tools to local compose MySQL: `127.0.0.1` + MYSQL_PUBLISH_PORT
# Dev с remote БД: scripts/dev-remote.ps1 (см. scripts/README.md)
MYSQL_HOST=mysql
MYSQL_PORT=3306
# Optional override: mysql+pymysql://user:pass@host:port/db?charset=utf8mb4
# DATABASE_URL=

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Optional direct publish on host (compose maps this)
API_PUBLISH_PORT=8000

# --- Nginx (host) ---
NGINX_HTTP_PORT=8080

# --- MySQL (host publish, optional for GUI clients; avoid clash with local MySQL) ---
MYSQL_PUBLISH_PORT=3307

# --- CS2 / Fake Game Server (TZ002; secrets — never commit real values) ---
# Platform ingest: POST /api/v1/internal/cs2/events (HMAC).
CS2_WEBHOOK_SECRET=dev_webhook_secret_change_me
# FAKE_CS2_PLATFORM_URL=http://127.0.0.1:8000
# FAKE_CS2_MATCH_ID=m_dev
# FAKE_CS2_SERVER_ID=srv_fake
# FAKE_CS2_WEBHOOK_SECRET=dev_webhook_secret_change_me
# FAKE_CS2_LISTEN_PORT=27099
# CS2_GAME_ENDPOINT_URL=http://127.0.0.1:27099

# --- CS2 VPS / Bridge (live; fill on VPS only) ---
# CS2_INSTALL_DIR=/opt/cs2
# STK_BRIDGE_COMMAND_PORT=27099
# PLATFORM_PUBLIC_URL=http://127.0.0.1:8000

# --- Demo durable (ADR-034; local stub path) ---
DEMO_DURABLE_ROOT=data/demos

# --- Director Agent (TZ003; stub auth for Agent WS) ---
# WS: /ws/agent/{matchId}?token=...  or header X-STK-Agent-Token
STK_AGENT_TOKEN=dev_agent_token_change_me

# --- Invite sessions (TZ004; HMAC secret for short-lived bearer) ---
STK_SESSION_SECRET=dev_session_secret_change_me

# --- Organizer auth (TZ005; instance-per-organizer bootstrap) ---
STK_ORGANIZER_USERNAME=organizer
STK_ORGANIZER_PASSWORD=changeme_organizer

# --- Admin deep-links (TZ005 P5; origins for invite/director URLs) ---
STK_DASHBOARD_ORIGIN=http://127.0.0.1:5174
STK_JUDGE_ORIGIN=http://127.0.0.1:5175
STK_WATCH_ORIGIN=http://127.0.0.1:5173

# --- WebRTC TURN (TZ004; compose --profile webrtc) ---
TURN_HOST=127.0.0.1
TURN_PORT=3478
TURN_SECRET=dev_turn_secret_change_me
TURN_TTL_SECONDS=300
TURN_REALM=stk.local
